{
  "name": "hexo-custom-rss",
  "version": "1.0.5",
  "description": "通过 tag、category 过滤生成的 rss，可自定义路径",
  "author": "CaoMeiYouRen",
  "private": false,
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "cross-env NODE_ENV=production eslint src --fix",
    "release": "semantic-release",
    "prebuild": "rimraf dist",
    "build": "cross-env NODE_ENV=production tsup",
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "dev:tsup": "cross-env NODE_ENV=development tsup --watch",
    "start": "node ./dist/index",
    "start:tsx": "cross-env NODE_ENV=production tsx src/index.ts",
    "commit": "cz",
    "prepare": "husky install",
    "test": "vitest run"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/debug": "^4.1.12",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.10.5",
    "@types/xml2js": "^0.4.14",
    "commitizen": "^4.3.1",
    "commitlint-config-cmyr": "^1.0.1",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog-cmyr": "^2.0.0",
    "debug": "^4.4.0",
    "eslint": "^9.0.0",
    "eslint-config-cmyr": "^2.0.0",
    "hexo": "^7.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "rimraf": "^6.0.1",
    "semantic-release": "21.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6",
    "warehouse": "^5.0.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog-cmyr"
    }
  },
  "changelog": {
    "language": "zh"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "npm run lint",
      "git add"
    ]
  },
  "keywords": [
    "hexo",
    "rss",
    "atom"
  ],
  "homepage": "https://github.com/CaoMeiYouRen/hexo-custom-rss#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaoMeiYouRen/hexo-custom-rss.git"
  },
  "bugs": {
    "url": "https://github.com/CaoMeiYouRen/hexo-custom-rss/issues"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "mime-types": "^2.1.35",
    "tslib": "^2.8.1",
    "xml2js": "^0.6.2"
  },
  "pnpm": {
    "overrides": {
      "compare-func": "^2.0.0",
      "katex": "^0.16.21",
      "vite": "^5.4.12"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "hexo": {
    "version": ">= 3.0.0",
    "type": "plugin"
  },
  "peerDependencies": {
    "hexo": ">= 3.0.0"
  }
}
